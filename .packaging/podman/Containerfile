FROM docker.io/library/golang:1.27.4-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api/ ./api/
COPY cmd/ ./cmd/
COPY financial/ ./financial/
COPY internal/ ./internal/
COPY provider/ ./provider/
COPY providers/ ./providers/
COPY source/ ./source/
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/wake ./cmd/wake

FROM registry.fedoraproject.org/fedora:44

RUN dnf -y --setopt=install_weak_deps=False install socat && dnf clean all
COPY --from=build /out/wake /usr/local/bin/wake

ENV XDG_CONFIG_HOME=/config XDG_DATA_HOME=/data XDG_RUNTIME_DIR=/run
ENTRYPOINT ["/usr/local/bin/wake"]
