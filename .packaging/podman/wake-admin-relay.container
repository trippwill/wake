[Unit]
Description=Wake private admin socket relay
After=wake.service

[Container]
ContainerName=wake-admin-relay
Image=localhost/wake:local
Pull=never
Pod=wake.pod
User=1000
Group=1000
DropCapability=all
NoNewPrivileges=true
Volume=/run/wake-podman/sockets:/run/wake:Z
Entrypoint=/usr/bin/socat
Exec=UNIX-LISTEN:/run/wake/admin.sock,mode=0600,umask=0177,unlink-early,fork TCP4:127.0.0.1:8787
StopTimeout=10

[Service]
TimeoutStopSec=20s
Restart=on-failure
RestartSec=5s
