{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": ["**", "!internal/transport/admin/assets/vendor/**"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "html": { "experimentalFullSupportEnabled": true, "formatter": { "enabled": false } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "nursery": { "useControlLabel": "error" }
    }
  }
}
