set -euo pipefail
export WAKE_SCREENSHOT_DIR="$PWD/.cache/browser/screenshots"
mkdir -p .cache/test-results
go test -json -tags=browser -run '^TestBrowser(Shell|ProxySession)$' -count=1 -timeout=5m ./internal/transport/admin ./internal/daemon \
  | tee .cache/test-results/browser-smoke.jsonl
