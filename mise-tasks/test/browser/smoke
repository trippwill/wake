export WAKE_SCREENSHOT_DIR="$PWD/.cache/browser/screenshots"
mkdir -p .cache/test-results
go test -json -tags=browser -run '^TestBrowserShell$' -count=1 -timeout=5m ./internal/transport/admin \
  | tee .cache/test-results/browser-smoke.jsonl
