set -euo pipefail
mkdir -p .cache/test-results
# Leave time for setup and artifact upload within the 15-minute CI job.
go test -json -race -count=1 -timeout=13m ./internal/credential ./internal/daemon ./internal/persistence/sqlite ./internal/transport/cli ./internal/architecture \
  | tee .cache/test-results/focused.jsonl
