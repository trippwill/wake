#MISE description="Repeat stateful and responsive browser workflows three times"
set -euo pipefail
export WAKE_SCREENSHOT_DIR="$PWD/.cache/browser/screenshots"
mkdir -p .cache/test-results
go test -json -tags=browser -run '^TestBrowser(AccountWorkflow|PollingIntervals|GridNavigationAndPreferences|GridRefreshAndInteraction|CorrectionAndEvidenceNavigation|ResponsiveGridAndNavigation)$' -count=3 -timeout=10m ./internal/transport/admin ./internal/daemon \
  | tee .cache/test-results/browser-repeat.jsonl
