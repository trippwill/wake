#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 trippwill
# SPDX-License-Identifier: MPL-2.0
#MISE description="Publish CI-tested amd64 and arm64 appliance images for a release tag"
set -euo pipefail

bash .mise/tasks/release/check-tag
version=$GITHUB_REF_NAME
revision=$(git rev-parse HEAD)
image="ghcr.io/trippwill/wake:$version"

for architecture in amd64 arm64; do
  podman load --input ".cache/container/wake-$architecture.tar"
  saved="localhost/wake:ci-$architecture"
  if [[ $(podman image inspect --format '{{.Architecture}}' "$saved") != "$architecture" ||
        $(podman image inspect --format '{{index .Labels "org.opencontainers.image.revision"}}' "$saved") != "$revision" ||
        $(podman image inspect --format '{{index .Labels "org.opencontainers.image.version"}}' "$saved") != "$version" ]]; then
    printf 'Image %s does not match %s at revision %s for %s.\n' "$saved" "$version" "$revision" "$architecture" >&2
    exit 1
  fi
done

auth=$(mktemp)
printf '{"auths":{}}\n' > "$auth"
manifest="localhost/wake-release:$version"
cleanup() {
  rm -f "$auth"
  podman manifest rm "$manifest" >/dev/null 2>&1 || true
}
trap cleanup EXIT
export REGISTRY_AUTH_FILE=$auth
printf '%s' "${GHCR_TOKEN:?registry token required}" |
  podman login --username "${GITHUB_ACTOR:?registry user required}" --password-stdin ghcr.io
# Older Podman versions resolve bare manifest sources as registry references.
podman manifest create "$manifest" containers-storage:localhost/wake:ci-amd64 containers-storage:localhost/wake:ci-arm64
podman manifest push --all "$manifest" "docker://$image"

if [[ -n ${GITHUB_STEP_SUMMARY:-} ]]; then
  cat >> "$GITHUB_STEP_SUMMARY" <<EOF
Published image: \`$image\`

Matching Quadlet: https://raw.githubusercontent.com/trippwill/wake/$revision/.container/wake.container
EOF
fi
