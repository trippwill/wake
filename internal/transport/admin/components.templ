package admin

import (
	"crypto/sha256"
	"fmt"
	"go.trippwill.dev/wake/internal/application"
	"go.trippwill.dev/wake/provider"
	"net/url"
	"strconv"
	"strings"
)

templ PageHeader(title, description string) {
	<header class="wake-page-header">
		<h1>{ title }</h1>
		if description!="" {
			<p>{ description }</p>
		}
	</header>
}

templ StateBadge(value string) {
	<span class="wake-state" data-state={ stateKind(value) }>{ value }</span>
}

templ InstrumentBadge(instrument application.Instrument) {
	<span class="wake-state" data-state={ stateKind(string(instrument.Status())) }>{ instrumentStatus(instrument) }</span>
}

templ ActivityBadge(state application.ActivityState) {
	<span class="wake-state" data-state={ activityBadgeKind(state) }>{ activityStatus(state) }</span>
}

func activityBadgeKind(state application.ActivityState) string {
	if state.NeedsReview() {
		return "warning"
	}
	return "neutral"
}

templ ObservationBadge(outcome application.ObservationOutcome) {
	<span class="wake-state" data-state={ observationBadgeKind(outcome) }>{ observationStatus(outcome) }</span>
}

func observationBadgeKind(outcome application.ObservationOutcome) string {
	if outcome.NeedsReview() {
		return "warning"
	}
	return "neutral"
}

func stateKind(value string) string {
	switch value {
	case "resolved", "complete", "completed", "Processing complete":
		return "success"
	case "failed", "Failure", "malformed":
		return "error"
	case "needs review", "conflict", "ambiguous", "paused", "provisional":
		return "warning"
	default:
		return "neutral"
	}
}

templ AcceptedDetailScope() {
	<p class="wake-help">Accepted details reflect this page load. <a href="" data-refresh-accepted>Refresh accepted details</a>. Retained observations update independently.</p>
}

templ Grid(kind, endpoint, label string) {
	<section class="wake-grid" id={ kind + "-grid" } data-grid={ kind } data-grid-url={ endpoint } aria-label={ label }>
		<div class="wake-grid-controls">
			<p role="status" data-grid-status>Loading table…</p>
			<button class="btn btn-sm" type="button" data-grid-retry hidden>Retry table</button>
			<a href="/login" data-grid-signin hidden>Sign in again</a>
			<button class="btn btn-sm" type="button" data-grid-reset>Reset columns</button>
		</div>
		if kind=="observations" {
			<form data-observation-filters><label for="observation-search">Search retained observations</label><input id="observation-search" class="input" type="search" name="q" maxlength="256" value={ page(ctx).Query.Get("observations_q") }/><button class="btn" type="submit">Search</button></form>
		}
		<p class="wake-help">Sort, filter and page across all matching records. 50 rows per page. Enter sorts a focused heading; Alt + arrow keys resize it.</p>
		<div data-grid-table></div>
		<noscript><p class="wake-notice">JavaScript is required to display this table.</p></noscript>
	</section>
}

templ ObservationHistory(kind, id string) {
	@Grid("observations", "/grids/observations?subject="+kind+"&id="+url.QueryEscape(id), "Retained observations")
}

func comparisonText(value application.CorrectionValue) string {
	if value.Label != "" {
		return value.Label
	}
	if value.Value == "" {
		if value.Currency != "" {
			return "Unknown " + value.Currency
		}
		return "Unknown"
	}
	return strings.TrimSpace(value.Value + " " + value.Currency + " " + value.Unit)
}

templ ComparisonRows(f application.CorrectionForm, c application.CorrectionCandidate, different bool) {
	<section class="wake-table-scroll" aria-label="Accepted and candidate values">
		<table class="table">
			<caption>Accepted and candidate values</caption><thead><tr><th scope="col">Field</th><th scope="col">Accepted</th><th scope="col">Candidate</th></tr></thead>
			<tbody>
				for _,field:=range comparisonFields(f,c) {
					if v,ok:=c.Fields[field];ok && (f.Values[field]!=v)==different {
						<tr data-different={ strconv.FormatBool(different) }>
							<th scope="row">
								{ fieldLabel(field) }
								if different {
									<span class="wake-difference">Different</span>
								}
							</th>
							<td>{ comparisonText(f.Values[field]) }</td>
							<td>{ comparisonText(v) }</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</section>
}

templ CandidateComparison(f application.CorrectionForm, c application.CorrectionCandidate) {
	<section class="wake-comparison" data-candidate={ c.Value }>
		<h3>Candidate comparison</h3>
		if hasDifferences(f,c) {
			@ComparisonRows(f, c, true)
		} else {
			<p>The candidate matches the currently accepted comparable fields.</p>
		}
		<details>
			<summary>Show unchanged fields</summary>@ComparisonRows(f, c, false)
		</details>
	</section>
}

func observationID(row application.Observation) string {
	sum := sha256.Sum256([]byte(row.Artifact + "\x00" + row.Version + "\x00" + row.Location))
	return fmt.Sprintf("observation-%x", sum)
}

templ SubmissionFailure(csrf, path, message string, draft url.Values, descriptor provider.Descriptor, operation submissionKind) {
	@PageHeader("Unable to save", "Review the error and retry your intended change.")
	<p class="wake-notice wake-error" role="alert" tabindex="-1" data-error-summary>{ message }</p>
	if operation!=submissionNone {
		<form method="post" action={ templ.SafeURL(path) }>
			<input type="hidden" name="csrf" value={ csrf }/>
			if operation==submissionConfirm {
				<label for="retry-name">Name<input class="input" id="retry-name" name="name" value={ draft.Get("name") } required maxlength="256"/></label>
			}
			if operation==submissionCreate || operation==submissionSettings {
				<input type="hidden" name="provider" value={ descriptor.ID() }/>
				<p><label for="retry-name">Connection name</label><input class="input" id="retry-name" name="connection_name" value={ draft.Get("connection_name") } required maxlength="256"/></p>
				for _,field:=range descriptor.Fields() {
					if field.Kind()==provider.TextField {
						<p><label for={ providerFieldID("retry", descriptor.ID(), field) }>{ field.Label() }</label><input class="input" id={ providerFieldID("retry", descriptor.ID(), field) } name={ "setting." + field.Key() } value={ draft.Get("setting." + field.Key()) } required?={ field.Required() } maxlength="4096"/></p>
					}
				}
			}
			if operation==submissionConfirm {
				<label for="retry-currency">Account currency (optional)<input class="input" id="retry-currency" name="currency" value={ draft.Get("currency") } maxlength="3" pattern="[A-Z]{3}"/></label>
				for _,key:=range []string{"artifact","authority","kind","scope","account"} {
					<input type="hidden" name={ key } value={ draft.Get(key) }/>
				}
			}
			if operation==submissionSecret {
				<input type="hidden" name="secret_key" value={ draft.Get("secret_key") }/>
			}
			if operation==submissionCreate || operation==submissionSecret {
				for _,field:=range descriptor.Fields() {
					if field.Kind()==provider.SecretField && (operation==submissionCreate || draft.Get("secret_key")==field.Key()) {
						<p><label for={ providerFieldID("retry", descriptor.ID(), field) }>{ field.Label()+" (enter again)" }</label><input class="input" id={ providerFieldID("retry", descriptor.ID(), field) } name={ "secret." + field.Key() } type="password" required?={ field.Required() } maxlength="4096" autocomplete="new-password"/></p>
					}
				}
			}
			if operation==submissionReference {
				<label for="retry-key">OpenFIGI key (enter again, or leave empty for anonymous access)<input class="input" id="retry-key" name="key" type="password" maxlength="4096" autocomplete="new-password"/></label>
			}
			<button class="btn btn-primary" type="submit">Retry saving</button>
		</form>
	}
	<p><a href="/connections">Return to connections</a></p>
}
