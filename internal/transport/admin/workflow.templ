package admin

import (
	"crypto/rand"
	"go.trippwill.dev/wake/financial"
	"go.trippwill.dev/wake/internal/application"
	"go.trippwill.dev/wake/provider"
	"go.trippwill.dev/wake/source"
	"strconv"
)

func known(text string) string {
	if text == "" {

		return unknownValue
	}
	return text
}

func operationLabel(operation string) string {
	if operation == "discover" {

		return "Account discovery"
	}
	return "Source synchronization"
}
func progressLabel(code provider.ProgressPhase) string {
	switch code {
	case "":
		return "Waiting for work"
	case "requesting":
		return "Contacting source"
	case "waiting":
		return "Waiting for source work"
	case "paced":
		return "Waiting for the shared request allowance"
	case "retained":
		return "Evidence retained"
	case "unavailable":
		return "Requested history unavailable; automatic retry retained"
	default:
		return "Waiting to retry source work"
	}
}

func currencyText(c financial.Currency) string {
	if c == (financial.Currency{}) {
		return ""
	}
	return c.String()
}

templ ConfirmAccount(csrf, id string, candidate application.Candidate) {
	@Breadcrumbs("Confirm account")
	@PageHeader("Confirm account", "Review the discovered account before granting automatic synchronization.")
	<p>Source account { candidate.Candidate.Reference().Value() }. Confirmation grants authority for this source account. Automatic acquisition runs when the source supports it. Missing profile fields remain unknown.</p>
	<section class="wake-card">
		<h2>Account authority</h2>
		<form method="post" action={ templ.SafeURL("/connections/" + id + "/confirm") }>
			<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="artifact" value={ candidate.Artifact }/>
			<input type="hidden" name="authority" value={ candidate.Candidate.Reference().Authority() }/><input type="hidden" name="kind" value={ candidate.Candidate.Reference().Kind() }/><input type="hidden" name="scope" value={ candidate.Candidate.Reference().Scope() }/><input type="hidden" name="account" value={ candidate.Candidate.Reference().Value() }/>
			<p><label for="account-name">Account display name</label><input class="input" id="account-name" name="name" value={ candidate.Candidate.Name() } required maxlength="256"/></p>
			<p><label for="account-currency">Account currency (optional)</label><input class="input" id="account-currency" name="currency" value={ currencyText(candidate.Candidate.Currency()) } pattern="[A-Z]{3}" maxlength="3"/></p>
			<button class="btn btn-primary" type="submit">Confirm account</button>
		</form>
	</section>
}

templ ExecutionPage(d application.ExecutionDetail) {
	@Breadcrumbs("Activity detail")
	@PageHeader(stringTitle(string(d.Execution.Terms().Fields().Side))+" "+known(d.Context.InstrumentName), d.Context.AccountName+" · "+d.Execution.Terms().Fields().TradeDate.String())
	@AcceptedDetailScope()
	<section class="wake-card">
		<div class="wake-card-heading">
			<h2>Financial summary</h2>
			<div class="wake-actions">
				@ActivityBadge(d.Execution.State())
				<a class="btn" href={ templ.SafeURL(navURL(ctx, "/activity/"+d.Execution.ID()+"/correct")) }>Correct accepted data</a>
			</div>
		</div>
		<dl>
			<dt>Side</dt>
			<dd>{ string(d.Execution.Terms().Fields().Side) }</dd>
			if d.Execution.Terms().Fields().Instrument.Kind()==source.Debt {
				<dt>Face amount (nominal)</dt>
				<dd>{ d.Execution.Terms().Fields().Quantity.Value() }</dd>
				<dt>Reported price</dt>
				<dd>{ priceText(d.Execution.Terms().Fields().Price) }</dd>
			} else {
				<dt>{ "Quantity ("+d.Execution.Terms().QuantityUnit()+")" }</dt>
				<dd>{ d.Execution.Terms().Fields().Quantity.Value() }</dd>
				<dt>{ "Price ("+d.Execution.Terms().PriceBasis()+")" }</dt>
				<dd>{ priceText(d.Execution.Terms().Fields().Price) }</dd>
			}
			<dt>Trade date</dt>
			<dd>{ d.Execution.Terms().Fields().TradeDate.String() }</dd>
			<dt>Execution time (reported precision)</dt>
			<dd>{ known(d.Execution.Terms().Fields().ExecutedAt.String()) }</dd>
		</dl>
		<a href={ templ.SafeURL(navURL(ctx, "/instruments/"+d.Execution.Instrument())) }>Inspect instrument</a>
	</section>
	<section class="wake-card">
		<h2>Monetary terms</h2>
		if d.Execution.Terms().Fields().Instrument.Kind()==source.Debt {
			<dl><dt>Reported principal</dt><dd>{ moneyText(d.Execution.Terms().Fields().Gross) }</dd><dt>Proceeds</dt><dd>{ moneyText(d.Execution.Terms().Fields().Proceeds) }</dd><dt>Trade net cash</dt><dd>{ moneyText(d.Execution.Terms().Fields().Net) }</dd><dt>Accrued interest</dt><dd>{ moneyText(d.Execution.Terms().Fields().AccruedInterest) }</dd></dl>
			<p class="wake-help">Trade net cash and accrued interest are separate reported amounts. No combined settlement total is calculated.</p>
			<details><summary>Settlement and additional monetary terms</summary><dl><dt>Reported settlement date</dt><dd>{ dateText(d.Execution.Terms().Fields().SettlementDate) }</dd><dt>Net cash with billable</dt><dd>{ moneyText(d.Execution.Terms().Fields().NetWithBillable) }</dd></dl></details>
		} else {
			<dl><dt>Gross amount</dt><dd>{ moneyText(d.Execution.Terms().Fields().Gross) }</dd><dt>Net cash</dt><dd>{ moneyText(d.Execution.Terms().Fields().Net) }</dd></dl>
			<details><summary>Settlement and additional monetary terms</summary><dl><dt>Reported settlement date</dt><dd>{ dateText(d.Execution.Terms().Fields().SettlementDate) }</dd><dt>Proceeds</dt><dd>{ moneyText(d.Execution.Terms().Fields().Proceeds) }</dd><dt>Accrued interest</dt><dd>{ moneyText(d.Execution.Terms().Fields().AccruedInterest) }</dd><dt>Net cash with billable</dt><dd>{ moneyText(d.Execution.Terms().Fields().NetWithBillable) }</dd></dl></details>
		}
		if len(d.Execution.Terms().Fields().Charges)>0 {
			<section class="wake-table-scroll" aria-label="Attached charges">
				<table class="table">
					<caption>Attached charges</caption><thead><tr><th scope="col">Role</th><th scope="col">Qualification</th><th scope="col">Amount</th></tr></thead>
					<tbody>
						for _,c:=range d.Execution.Terms().Fields().Charges {
							<tr><td>{ c.Field() }</td><td>{ c.Scope() }</td><td>{ moneyText(c.Money()) }</td></tr>
						}
					</tbody>
				</table>
			</section>
		}
	</section>
	if !d.Execution.Terms().Fields().Instrument.Option().IsZero() || !d.Execution.Terms().Fields().Instrument.Debt().IsZero() {
		<section class="wake-card">
			<h2>Contract terms</h2>@OptionFacts(d.Execution.Terms().Fields().Instrument.Option())
			@DebtFacts(d.Execution.Terms().Fields().Instrument.Debt())
		</section>
	}
	<details class="wake-card">
		<summary>Relationships and source context</summary>@RelationshipLinks(d.Relationships)
		<dl><dt>Reported order membership</dt><dd>{ referenceText(d.Execution.Terms().Fields().Order) }</dd><dt>Opening/closing</dt><dd>{ known(string(d.Execution.Terms().Fields().PositionEffect)) }</dd><dt>Source event</dt><dd>{ referenceText(d.Execution.Terms().Fields().Event) }</dd><dt>Wake execution identity</dt><dd>{ d.Execution.ID() }</dd></dl>
	</details>
	<section class="wake-card">
		<h2>Evidence and decisions</h2>@CorrectionReviews(d.Corrections)
		<details>
			<summary>Retained observations and acceptance rules</summary>@ObservationHistory("activity", d.Execution.ID())
		</details>
	</section>
}

templ InstrumentPage(d application.InstrumentDetail) {
	@Breadcrumbs("Instrument")
	@PageHeader(known(d.Instrument.Name()), d.Instrument.Kind()+" · "+known(d.Instrument.Ticker()))
	@AcceptedDetailScope()
	<section class="wake-card">
		<div class="wake-card-heading">
			<h2>Instrument identity</h2>
			<div class="wake-actions">
				@InstrumentBadge(d.Instrument)
				<a class="btn" href={ templ.SafeURL(navURL(ctx, "/instruments/"+d.Instrument.ID()+"/correct")) }>Correct instrument data</a>
			</div>
		</div>
		<dl><dt>Reference FIGI</dt><dd>{ known(d.Instrument.FIGI()) }</dd><dt>Reported label</dt><dd>{ known(d.Instrument.Reported().Name()) }</dd><dt>Reported symbol</dt><dd>{ known(d.Instrument.Reported().Ticker()) }</dd></dl>
		if d.Instrument.Kind()=="option" {
			<p>
				Underlier:
				if d.Underlier!="" {
					<a href={ templ.SafeURL(navURL(ctx, "/instruments/"+d.Underlier)) }>Inspect linked underlier</a>
				} else {
					Unknown
				}
			</p>
		}
	</section>
	<p>Contract and issue terms belong to their dated observations and activity. Inspect supporting observations below for historical terms.</p>
	if reason:=d.Instrument.ReferenceMetadata().Reason;reason!="" {
		<p class="wake-notice">{ referenceReasonText(reason) }</p>
	}
	if len(d.Listings)>0 {
		<section class="wake-card">
			<h2>Listings</h2>
			<section class="wake-table-scroll" aria-label="Listings">
				<table class="table">
					<caption>Instrument listings</caption><thead><tr><th scope="col">Venue</th><th scope="col">Symbol</th><th scope="col">Currency</th><th scope="col">Reference FIGI</th></tr></thead>
					<tbody>
						for _,l:=range d.Listings {
							<tr><td>{ known(l.Venue()) }</td><td>{ known(l.Ticker()) }</td><td>{ l.Currency() }</td><td>{ known(l.FIGI()) }</td></tr>
						}
					</tbody>
				</table>
			</section>
		</section>
	}
	<details class="wake-card">
		<summary>Reported references and reference evidence</summary>
		<p>Instrument linking rule: { d.Instrument.Rule() }</p>
		<ul>
			<li>{ d.Instrument.Reported().Reference().Authority() } { d.Instrument.Reported().Reference().Kind() } { d.Instrument.Reported().Reference().Value() }</li>
			for _,id:=range d.Instrument.Reported().Identifiers() {
				<li>{ string(id.Kind()) }: { id.Value() } ({ id.Field() })</li>
			}
			for _,attempt:=range d.References {
				<li>{ attempt.Status } · { attempt.Retrieved } · <a href={ templ.SafeURL(navURL(ctx, "/reference-evidence/"+attempt.Evidence)) }>OpenFIGI mapping evidence</a></li>
			}
		</ul>
		<p>Wake instrument identity: { d.Instrument.ID() }</p>
	</details>
	<section class="wake-card">
		<h2>Supporting observations</h2>@ObservationHistory("instrument", d.Instrument.ID())
	</section>
}

templ EvidencePage(id, context, body string) {
	@Breadcrumbs("Reference evidence")
	@PageHeader("Reference evidence", id)
	<section class="wake-card"><h2>Retained reference lookup</h2><p>{ context }</p><a href="#original-content">Inspect retained request and response</a></section>
	<details class="wake-card" id="original-content"><summary>Original request and response</summary><pre>{ body }</pre></details>
}

templ OptionFacts(terms source.OptionTerms) {
	if !terms.IsZero() {
		<dl>
			<dt>Put/call</dt>
			<dd>{ known(string(terms.Fields().Right)) }</dd>
			<dt>Expiry</dt>
			<dd>{ dateText(terms.Fields().Expiry) }</dd>
			<dt>Reported strike</dt>
			<dd>{ priceText(terms.Fields().Strike) }</dd>
			<dt>Premium multiplier</dt>
			<dd>{ known(terms.Fields().Multiplier.Value()) }</dd>
			<dt>Terms effective from</dt>
			<dd>{ dateText(terms.Fields().EffectiveFrom) }</dd>
			<dt>Reported deliverables</dt>
			<dd>
				if len(terms.Fields().Deliverables)==0 {
					Unknown
				} else {
					<ul>
						for _, component := range terms.Fields().Deliverables {
							<li>
								if !component.Security().IsZero() {
									{ component.Quantity().Value() } units of { component.Security().Authority() } { component.Security().Value() }
								} else {
									{ moneyText(component.Cash()) }
								}
							</li>
						}
					</ul>
				}
			</dd>
		</dl>
	}
}

func dateText(d financial.Date) string {
	if d.IsZero() {

		return unknownValue
	}
	return d.String()
}
func priceText(p financial.Price) string {
	if p.Amount() == "" {

		return unknownValue
	}
	return p.Amount() + " " + p.Currency().String()
}
func moneyText(m financial.Money) string {
	if m.Amount() == "" {

		return unknownValue
	}
	return m.Amount() + " " + m.Currency().String()
}

func referenceText(r source.Reference) string {
	if r.IsZero() {

		return unknownValue
	}
	return r.Authority() + " " + r.Kind() + " [" + r.Scope() + "] " + r.Value()
}

templ RelationshipLinks(links []application.Relationship) {
	<h2>Explicit relationships</h2>
	if len(links)==0 {
		<p>No explicit lifecycle relationship reported.</p>
	}
	<ul>
		for _,link:=range links {
			<li>
				{ link.Kind } · { link.Target }
				if link.TargetID!="" {
					<a href={ templ.SafeURL(navURL(ctx, "/activity/"+link.TargetID)) }>Inspect related activity</a>
				} else {
					<span>Endpoint unresolved</span>
				}
			</li>
		}
	</ul>
}

templ LifecyclePage(d application.LifecycleDetail) {
	@Breadcrumbs("Option outcome")
	@PageHeader(stringTitle(string(d.Lifecycle.Terms().Fields().Kind))+" · "+known(d.Context.InstrumentName), d.Context.AccountName+" · "+d.Lifecycle.Terms().Fields().Date.String())
	@AcceptedDetailScope()
	<section class="wake-card">
		<div class="wake-card-heading">
			<h2>Reported option outcome</h2>
			<div class="wake-actions">
				@ActivityBadge(d.Lifecycle.State())
				<a class="btn" href={ templ.SafeURL(navURL(ctx, "/activity/"+d.Lifecycle.ID()+"/correct")) }>Correct accepted data</a>
			</div>
		</div>
		<dl><dt>Quantity (contracts)</dt><dd>{ d.Lifecycle.Terms().Fields().Quantity.Value() }</dd><dt>Reported date</dt><dd>{ d.Lifecycle.Terms().Fields().Date.String() }</dd><dt>Reported time</dt><dd>{ known(d.Lifecycle.Terms().Fields().At.String()) }</dd></dl><a href={ templ.SafeURL(navURL(ctx, "/instruments/"+d.Lifecycle.Instrument())) }>Inspect option contract</a>
	</section>
	<section class="wake-card">
		<h2>Contract terms</h2>@OptionFacts(d.Lifecycle.Terms().Fields().Instrument.Option())
	</section>
	<section class="wake-card">
		@RelationshipLinks(d.Relationships)
	</section>
	<details class="wake-card"><summary>Source event and identity</summary><dl><dt>Source event</dt><dd>{ referenceText(d.Lifecycle.Terms().Fields().Event) }</dd><dt>Reported order membership</dt><dd>{ referenceText(d.Lifecycle.Terms().Fields().Order) }</dd><dt>Wake activity identity</dt><dd>{ d.Lifecycle.ID() }</dd></dl></details>
	<section class="wake-card">
		<h2>Evidence and decisions</h2>@CorrectionReviews(d.Corrections)
		<details>
			<summary>Retained observations and rules</summary>@ObservationHistory("activity", d.Lifecycle.ID())
		</details>
	</section>
}

templ DebtFacts(terms source.DebtTerms) {
	if !terms.IsZero() {
		<dl>
			<dt>Debt issue type</dt>
			<dd>{ known(string(terms.Fields().Type)) }</dd>
			<dt>Issue currency</dt>
			<dd>{ known(currencyText(terms.Fields().Currency)) }</dd>
			<dt>Maturity</dt>
			<dd>{ dateText(terms.Fields().Maturity) }</dd>
			<dt>Coupon rate (reported)</dt>
			<dd>{ known(terms.Fields().Coupon.Value()) }</dd>
			<dt>Original issue date</dt>
			<dd>{ dateText(terms.Fields().IssueDate) }</dd>
			<dt>Dated date</dt>
			<dd>{ dateText(terms.Fields().DatedDate) }</dd>
			<dt>Payments per year</dt>
			<dd>
				if terms.Fields().PaymentsPerYear==0 {
					Unknown
				} else {
					{ strconv.Itoa(terms.Fields().PaymentsPerYear) }
				}
			</dd>
		</dl>
	}
}

func currencyAmountText(a source.CurrencyAmount) string {
	return known(a.Amount()) + " " + currencyText(a.Currency())
}

templ ConversionPage(d application.ConversionDetail) {
	@Breadcrumbs("Currency conversion")
	@PageHeader("Convert "+currencyText(d.Conversion.Terms().Fields().Sent.Currency())+" to "+currencyText(d.Conversion.Terms().Fields().Received.Currency()), d.Context.AccountName+" · "+d.Conversion.Terms().Fields().Date.String())
	@AcceptedDetailScope()
	<section class="wake-card">
		<div class="wake-card-heading">
			<h2>Currency roles</h2>
			<div class="wake-actions">
				@ActivityBadge(d.Conversion.State())
				<a class="btn" href={ templ.SafeURL(navURL(ctx, "/activity/"+d.Conversion.ID()+"/correct")) }>Correct accepted data</a>
			</div>
		</div>
		<dl>
			<dt>Sent</dt>
			<dd>{ currencyAmountText(d.Conversion.Terms().Fields().Sent) }</dd>
			<dt>Received</dt>
			<dd>{ currencyAmountText(d.Conversion.Terms().Fields().Received) }</dd>
			<dt>Quoted rate</dt>
			<dd>
				{ priceText(d.Conversion.Terms().Fields().Rate) }
				if d.Conversion.Terms().Fields().Rate.Amount()!="" {
					per { currencyText(d.Conversion.Terms().Fields().RateBase) }
				}
			</dd>
			<dt>Reported date</dt>
			<dd>{ d.Conversion.Terms().Fields().Date.String() }</dd>
			<dt>Reported time</dt>
			<dd>{ known(d.Conversion.Terms().Fields().At.String()) }</dd>
		</dl>
	</section>
	<section class="wake-card">
		<h2>Monetary terms</h2>
		<dl><dt>Net cash</dt><dd>{ moneyText(d.Conversion.Terms().Fields().Net) }</dd></dl>@ChargesTable(d.Conversion.Terms().Fields().Charges)
		<details><summary>Additional monetary roles</summary><dl><dt>Gross</dt><dd>{ moneyText(d.Conversion.Terms().Fields().Gross) }</dd><dt>Proceeds</dt><dd>{ moneyText(d.Conversion.Terms().Fields().Proceeds) }</dd><dt>Net cash with billable</dt><dd>{ moneyText(d.Conversion.Terms().Fields().NetWithBillable) }</dd></dl></details>
	</section>
	<details class="wake-card"><summary>Source event and identity</summary><dl><dt>Source event</dt><dd>{ referenceText(d.Conversion.Terms().Fields().Event) }</dd><dt>Reported order membership</dt><dd>{ referenceText(d.Conversion.Terms().Fields().Order) }</dd><dt>Wake activity identity</dt><dd>{ d.Conversion.ID() }</dd></dl></details>
	<section class="wake-card">
		<h2>Evidence and decisions</h2>@CorrectionReviews(d.Corrections)
		<details>
			<summary>Retained observations and rules</summary>@ObservationHistory("activity", d.Conversion.ID())
		</details>
	</section>
}

templ CorrectionReviews(rows []application.CorrectionReview) {
	if len(rows)>0 {
		<h2>Source corrections</h2>
		<ul>
			for _,r:=range rows {
				<li>
					{ stringTitle(r.Kind) } · { correctionStatus(r.Status) }<details><summary>Reported source references</summary><p>{ r.Target }</p></details>
					for _,id:=range r.TargetIDs {
						<a href={ templ.SafeURL(navURL(ctx, "/activity/"+id)) }>Original activity</a>
					}
					for _,id:=range r.ReplacementIDs {
						<a href={ templ.SafeURL(navURL(ctx, "/activity/"+id)) }>Replacement activity</a>
					}
					<a href={ templ.SafeURL(navURL(ctx, "/evidence/"+r.Artifact)) }>Source instruction</a>
				</li>
			}
		</ul>
	}
}

func correctionPath(f application.CorrectionForm) string {
	if f.Kind == "instrument" {

		return "/instruments/" + f.ID + "/correct"
	}
	return "/activity/" + f.ID + "/correct"
}
func fieldLabel(s string) string {
	switch s {
	case "reported.order":
		return "Reported source order"
	case "reported.event":
		return "Reported source event"
	case "reported.event_aliases":
		return "Reported event aliases"
	case "reported.account":
		return "Reported source account"
	case "reported.relationships":
		return "Reported relationships"
	case "reported.instrument":
		return "Reported instrument identity"
	case "reported.trade_kind":
		return "Reported trade kind"
	case "option.reported_underlier":
		return "Reported option underlier"
	case "reference_identity":
		return "Reference identity (FIGI)"
	case "option.effective_from":
		return "Option terms effective from"
	case "option.deliverables":
		return "Reported option deliverables"
	case "debt.type":
		return "Debt type"
	case "debt.currency":
		return "Debt currency"
	case "debt.issue_date":
		return "Debt issue date"
	case "debt.dated_date":
		return "Debt dated date"
	case "debt.payments_per_year":
		return "Debt payments per year"
	case "charges":
		return "Attached charges (reported; read-only)"
	case "price":
		return "Price"
	case "quantity":
		return "Quantity"
	case "side":
		return "Buy or sell"
	case "gross":
		return "Gross amount"
	case "net":
		return "Net cash"
	case "proceeds":
		return "Proceeds"
	case "rate":
		return "Quoted rate"
	case "name":
		return "Name"
	case "ticker":
		return "Reported symbol"
	case "kind":
		return "Reported outcome"
	case "observation":
		return "Accepted fields from a reported observation"
	case "reference":
		return "Instrument reference candidate"
	case "underlier":
		return "Linked underlier"
	case "instrument":
		return "Linked instrument"
	case "listing":
		return "Linked listing (optional)"
	case "option.strike":
		return "Option strike"
	case "option.multiplier":
		return "Option premium multiplier"
	case "option.right":
		return "Option put/call"
	case "option.expiry":
		return "Option expiry"
	case "debt.coupon":
		return "Debt coupon rate"
	case "debt.maturity":
		return "Debt maturity"
	case "executed_at":
		return "Reported timestamp"
	case "trade_date":
		return "Activity date"
	case "settlement_date":
		return "Reported settlement date"
	case "accrued_interest":
		return "Accrued interest"
	case "net_billable":
		return "Net cash with billable"
	case "sent_amount":
		return "Sent amount"
	case "received_amount":
		return "Received amount"
	case "position_effect":
		return "Opening/closing qualification"
	}
	return s
}

templ DecisionMetadata(csrf string, f application.CorrectionForm) {
	<input type="hidden" name="csrf" value={ csrf }/>
	<input type="hidden" name="revision" value={ strconv.FormatInt(f.Revision, 10) }/>
	<input type="hidden" name="submission" value={ rand.Text() }/>
}

templ CorrectionPage(csrf string, f application.CorrectionForm) {
	@Breadcrumbs("Review / correct")
	@PageHeader("Correct accepted data", correctionContext(f))
	<p class="wake-help">{ known(f.AccountName) } · Revision { strconv.FormatInt(f.Revision,10) }</p>
	if f.Message!="" {
		<div class="wake-notice wake-error" role="alert" tabindex="-1" data-error-summary>
			<h2>Correction not saved</h2>
			<p>{ f.Message }</p>
			if f.Stale {
				<p>Current values are shown below. Review them before saving your draft again.</p>
			}
		</div>
	}
	<nav class="wake-tabs" aria-label="Review intent">
		for _,mode:=range []string{"field","evidence","decisions"} {
			<a href={ templ.SafeURL(modeURL(ctx, mode)) } aria-current={ currentPage(correctionMode(ctx, f) == mode) }>{ correctionModeLabel(mode) }</a>
		}
	</nav>
	if correctionMode(ctx,f)=="field" {
		<section class="wake-card">
			<h2>Correct a field or link</h2>
			<p class="wake-help">Your correction remains active until you replace or release it. Original evidence stays intact.</p>
			<form method="get" action={ templ.SafeURL(correctionPath(f)) } data-field-picker>
				<input type="hidden" name="mode" value="field"/><input type="hidden" name="origin" value={ origin(ctx) }/><input type="hidden" name="parent" value={ page(ctx).Query.Get("parent") }/>
				<p>
					<label for="decision-scope">What do you want to correct?</label>
					<select class="select" id="decision-scope" name="field" required>
						<option value="">Choose a field or link</option>
						for _,group:=range []string{"Financial terms","Dates and time","Contract terms","Identity and links"} {
							<optgroup label={ group }>
								for _,field:=range f.Fields {
									if fieldGroup(field)==group {
										<option value={ field } selected?={ selectedCorrectionField(ctx,f)==field }>{ fieldLabel(field) }</option>
									}
								}
							</optgroup>
						}
					</select>
				</p><button class="btn" type="submit" data-field-apply>Edit selected field</button>
			</form>
			<form method="post" action={ templ.SafeURL(taskURL(ctx, correctionPath(f))) } aria-label="Correct a field or link" data-correction data-check-url={ correctionPath(f) + "/check" } hidden?={ selectedCorrectionField(ctx,f)=="" }>
				@DecisionMetadata(csrf, f)
				<input type="hidden" name="action" value="set"/><input type="hidden" name="scope" value={ selectedCorrectionField(ctx, f) }/>
				<div data-editor-host>
					if selectedCorrectionField(ctx,f)!="" {
						@CorrectionEditor(f, selectedCorrectionField(ctx, f))
					}
				</div>
				<p id="decision-feedback" class="wake-help" role="status" aria-live="polite"></p>
				<details open?={ f.Draft.Rationale!="" }><summary>Add a reason (optional)</summary><label for="decision-rationale">Rationale</label><input class="input" id="decision-rationale" name="rationale" value={ f.Draft.Rationale } maxlength="1024"/></details>
				<button class="btn" type="button" data-check-again hidden>Retry validation</button>
				<a href="/login" data-correction-signin hidden>Sign in again</a>
				<button class="btn btn-primary" type="submit">
					if f.Stale {
						Save reviewed correction
					} else {
						Save correction
					}
				</button>
			</form>
			for _,field:=range f.Fields {
				<template data-field-template={ field }>
					@CorrectionEditor(f, field)
				</template>
			}
		</section>
		<details class="wake-card">
			<summary>All currently accepted fields</summary>
			<dl>
				for _,field:=range f.Fields {
					<dt>{ fieldLabel(field) }</dt>
					<dd>{ comparisonText(f.Values[field]) }</dd>
				}
			</dl>
		</details>
	} else if correctionMode(ctx,f)=="evidence" {
		<section class="wake-card">
			<h2>Select retained evidence</h2>
			<p>Compare a source candidate before choosing it. Separate link decisions remain in force.</p>
			if len(f.Candidates)==0 {
				<p>No retained candidates are available for this item.</p>
			} else {
				<form method="get" action={ templ.SafeURL(correctionPath(f)) } aria-label="Compare retained evidence" data-candidate-compare>
					<input type="hidden" name="mode" value="evidence"/><input type="hidden" name="origin" value={ origin(ctx) }/><input type="hidden" name="parent" value={ page(ctx).Query.Get("parent") }/>
					<p>
						<label for="decision-candidate">Retained candidate</label>
						<select class="select" id="decision-candidate" name="candidate" required>
							<option value="">Choose a retained candidate</option>
							for _,c:=range f.Candidates {
								<option value={ c.Value } selected?={ selectedCandidate(ctx,f)==c.Value }>{ c.Label }</option>
							}
						</select>
					</p><button class="btn" type="submit">Compare candidate</button>
				</form>
				for _,candidate:=range f.Candidates {
					if candidate.Value==selectedCandidate(ctx,f) {
						@CandidateComparison(f, candidate)
						<form method="post" action={ templ.SafeURL(taskURL(ctx, correctionPath(f))) } aria-label="Select retained evidence">
							@DecisionMetadata(csrf, f)
							<input type="hidden" name="action" value="set"/><input type="hidden" name="scope" value={ candidateScope(f) }/><input type="hidden" name="value" value={ candidate.Value }/>
							<details open?={ f.Draft.Rationale!="" }><summary>Add a reason (optional)</summary><label for="candidate-rationale">Rationale</label><input class="input" id="candidate-rationale" name="rationale" value={ f.Draft.Rationale } maxlength="1024"/></details>
							<button class="btn btn-primary" type="submit">
								if f.Stale {
									Save reviewed correction
								} else {
									Save candidate selection
								}
							</button>
						</form>
					}
				}
			}
		</section>
	} else {
		<section class="wake-card">
			<h2>Active decisions</h2>
			if activeDecisions(f)==0 {
				<p>No active operator decisions.</p>
			}
			<ul class="wake-task-list">
				for _,d:=range f.Decisions {
					if d.Active {
						<li>
							<div><h3>{ fieldLabel(d.Scope) }</h3><p>{ d.Text } { d.Currency }</p><p class="wake-help">{ d.Rationale }</p><details><summary>Attribution and identity</summary><p>{ d.Actor } · { d.At } · { d.ID }</p></details></div>
							<form method="post" action={ templ.SafeURL(taskURL(ctx, correctionPath(f))) } aria-label={ "Release " + fieldLabel(d.Scope) }>
								@DecisionMetadata(csrf, f)
								<input type="hidden" name="action" value="release"/><input type="hidden" name="scope" value={ d.Scope }/><button class="btn" type="submit">Release decision</button>
							</form>
						</li>
					}
				}
			</ul>
		</section>
		<details class="wake-card">
			<summary>Decision history</summary>
			<ul>
				for _,d:=range f.Decisions {
					<li>
						{ fieldLabel(d.Scope) } · { d.Action } · { d.Text } { d.Currency } · { d.Actor } · { d.At } · { d.Rationale }
						if d.Supersedes!="" {
							<span>Supersedes { d.Supersedes }</span>
						}
					</li>
				}
			</ul>
		</details>
	}
	<details class="wake-card wake-audit"><summary>Identity and decision policy</summary><p>Wake identity { f.ID }. Decisions control their selected scope until superseded or released. Original evidence stays intact.</p></details>
}

templ ChargesTable(rows []source.Charge) {
	if len(rows)>0 {
		<section class="wake-table-scroll" aria-label="Attached charges">
			<table class="table">
				<caption>Attached charges</caption><thead><tr><th scope="col">Role</th><th scope="col">Qualification</th><th scope="col">Amount</th></tr></thead>
				<tbody>
					for _,c:=range rows {
						<tr><td>{ c.Field() }</td><td>{ c.Scope() }</td><td>{ moneyText(c.Money()) }</td></tr>
					}
				</tbody>
			</table>
		</section>
	}
}

func referenceReasonText(reason string) string {
	switch reason {
	case "missing_identifier":
		return "No supported identifier was reported. New source evidence is needed before a lookup can proceed."
	case "missing_parent":
		return "The lookup did not establish the parent identity required for this investment."
	case "competing_identity":
		return "The reference evidence identifies more than one investment. Review is required."
	case "conflicting_parents":
		return "Reference records disagree about an identifier's parent. Review is required."
	case "incompatible_subject":
		return "The reference result describes an incompatible kind of investment."
	case "incomplete_metadata":
		return "Identity is established, but some supporting reference metadata is incomplete."
	case "source_conflict":
		return "Source observations disagree about this investment's identity or underlier. Review is required."
	case "convergence_blocked":
		return "Another record for the same investment needs review before these entries can combine."
	case "operator_conflict":
		return "These entries identify the same investment, but operator choices must be reconciled before they can combine."
	default:
		return "Reference evidence needs review."
	}
}
