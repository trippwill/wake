package admin

templ AppearanceControls() {
	<div class="wake-appearance-controls" data-appearance-controls hidden>
		<label class="wake-field">
			<span>Theme</span>
			<select class="select" data-palette-preference></select>
		</label>
		<label class="wake-field">
			<span>Mode</span>
			<select class="select" data-theme-preference aria-describedby="appearance-mode-help">
				<option value="system">System</option>
				<option value="light">Light</option>
				<option value="dark">Dark</option>
			</select>
		</label>
		<p class="wake-help" id="appearance-mode-help">Select System to follow your device’s appearance.</p>
		<label class="wake-field">
			<span>Typography</span>
			<select class="select" data-typography-preference>
				<option value="default">Theme default</option>
				<option value="sans">System sans</option>
				<option value="serif">Editorial serif</option>
			</select>
		</label>
	</div>
}

templ NavigationLink(label string, href string, icon string, active bool) {
	<a
		class="wake-nav-link"
		href={ href }
		if active {
			aria-current="page"
		}
	>
		<svg class="wake-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
			<use href={ "/assets/brand/icons.svg#" + icon }></use>
		</svg>
		<span>{ label }</span>
	</a>
}
