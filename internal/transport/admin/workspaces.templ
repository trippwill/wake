package admin

import (
	"crypto/rand"
	"go.trippwill.dev/wake/internal/application"
	"go.trippwill.dev/wake/provider"
	"strconv"
)

templ Breadcrumbs(title string) {
	<nav class="wake-breadcrumbs" aria-label="Breadcrumb">
		<ol>
			<li><a href={ templ.SafeURL(origin(ctx)) }>{ originLabel(ctx) }</a></li>
			if localDestination(page(ctx).Query.Get("parent"))!="" {
				<li><a href={ templ.SafeURL(returnURL(ctx)) }>{ parentLabel(ctx) }</a></li>
			}
			<li aria-current="page">{ title }</li>
		</ol>
	</nav>
	<a class="wake-return" href={ templ.SafeURL(returnURL(ctx)) } data-return>Return to { parentLabel(ctx) }</a>
}

templ ActivityNavigation(view string) {
	<nav class="wake-tabs" aria-label="Activity views">
		<a href="/activity" aria-current={ currentPage(view == "all") }>All activity</a>
		<a href="/activity?view=review" aria-current={ currentPage(view == "review") }>Needs review</a>
		<a href="/activity?view=instruments" aria-current={ currentPage(view == "instruments") }>Instruments</a>
	</nav>
}

func currentPage(active bool) string {
	if active {
		return "page"
	}
	return "false"
}

templ DashboardOverview(view application.Dashboard) {
	@PageHeader("Overview", "Your account, current work and next useful action.")
	if view.Storage.Paused {
		<section class="wake-card wake-priority"><h2>Review recovered access</h2><p>Your retained history remains available. Repair access before resuming upstream work.</p><a class="btn btn-primary" href="/connections/recovery">Review recovery steps</a></section>
	} else if view.Account.ID()=="" {
		<section class="wake-card wake-priority">
			<h2>Connect and confirm an account</h2>
			<p>Configure a source, review its available account discovery, and confirm account authority before automatic synchronization.</p>
			if len(view.Connections)==0 {
				<a class="btn btn-primary" href="/connections/new">Add source connection</a>
			} else {
				<a class="btn btn-primary" href="/connections">Review account discovery</a>
			}
		</section>
	}
	if view.Account.ID()!="" {
		<section class="wake-card"><div class="wake-card-heading"><div><h2>{ view.Account.Details().Name() }</h2><p class="wake-help">{ strconv.Itoa(len(activityItems(view))) } activity records · { strconv.Itoa(len(view.Instruments)) } instruments</p></div><a class="btn btn-primary" href="/activity">Inspect activity</a></div></section>
		<div class="wake-columns">
			<section class="wake-card">
				<h2>Financial review</h2>
				if len(reviews(view))==0 {
					<p>No activity or identity conflicts are awaiting review.</p>
				} else {
					<p>{ strconv.Itoa(len(reviews(view))) } items need your judgment.</p>
					<ul class="wake-task-list">
						for _,item:=range reviews(view) {
							<li><a href={ templ.SafeURL(navURL(ctx, item.Href)) }>{ item.Label }</a><span class="wake-help">{ item.Reason }</span></li>
						}
					</ul>
				}
				<a href="/activity?view=review">Open Needs review</a>
			</section>
			<section class="wake-card">
				<h2>Source and system work</h2>
				if repairCount(view)>0 {
					<ul class="wake-task-list">
						for _,item:=range repairs(view) {
							<li><a href={ templ.SafeURL(item.Href) }>{ item.Label }</a><span class="wake-help">{ item.Reason }</span></li>
						}
					</ul>
				} else {
					<p>No recorded source or system failures.</p><a href="/connections">Inspect connections</a>
				}
				<p class="wake-help">Reachability, acquisition and processing have separate states. Report bounds do not prove complete history.</p>
				<a href="/activity?view=instruments&state=gaps">Inspect instrument reference gaps</a>
			</section>
		</div>
	}
	<section class="wake-card">
		<h2>Synchronization</h2>
		if len(view.Connections)==0 {
			<p>No connections configured.</p>
		} else {
			<ul class="wake-source-summary">
				for _,c:=range view.Connections {
					<li>
						<a href={ templ.SafeURL(connectionURL(c.ID, "status")) }>{ c.Name }</a>
						<span>
							if c.MissingAccess {
								@StateBadge("Access review required")
							} else if connectionFailure(view,c) {
								@StateBadge("failed")
							} else if view.Storage.Paused {
								@StateBadge("paused")
							} else {
								for _,work:=range sourceWork(view,c) {
									<span>{ operationLabel(work.Operation) }: { progressLabel(work.Progress) }</span>
								}
							}
						</span>
					</li>
				}
			</ul>
		}
	</section>
}

templ ConnectionsPage(csrf string, view application.Dashboard) {
	@PageHeader("Connections", "Source access, account authority and synchronization.")
	@ConnectionsNavigation("sources")
	if view.Storage.Paused {
		<section class="wake-card wake-priority"><h2>Upstream work is paused</h2><p>Review restored access before reconnecting to your sources.</p><a class="btn btn-primary" href="/connections/recovery">Review recovery steps</a></section>
	}
	<section id="workflow-progress" class="wake-card">
		<div class="wake-card-heading"><h2>Sources</h2><a class="btn" href="/connections/new">Add source connection</a></div>
		if len(view.Connections)==0 {
			<p>No sources configured. Add a connection to discover accounts.</p>
		}
		for _,c:=range view.Connections {
			<article class="wake-source-row">
				<div>
					<h3><a href={ templ.SafeURL(connectionURL(c.ID, "status")) }>{ c.Name }</a></h3>
					if view.Account.Connection()==c.ID {
						<p>{ view.Account.Details().Name() } · Authorized source</p>
					} else {
						<p>Account discovery</p>
					}
					for _,w:=range sourceWork(view,c) {
						<p class="wake-help">{ operationLabel(w.Operation) }: { progressLabel(w.Progress) }</p>
					}
				</div>
				<div class="wake-actions">
					if c.MissingAccess {
						<a class="btn" href={ templ.SafeURL(connectionURL(c.ID, "access")) }>Repair source access</a>
					} else {
						<a href={ templ.SafeURL(connectionURL(c.ID, "status")) }>Inspect source</a>
					}
				</div>
			</article>
			if view.Account.ID()=="" {
				@DiscoveredAccounts(c, view)
			}
		}
	</section>
}

templ ConnectionsNavigation(view string) {
	<nav class="wake-tabs" aria-label="Connection views"><a href="/connections" aria-current={ currentPage(view == "sources") }>Sources</a><a href="/connections/reference" aria-current={ currentPage(view == "reference") }>Instrument reference</a><a href="/connections/recovery" aria-current={ currentPage(view == "recovery") }>Recovery</a></nav>
}

templ ConnectionPage(csrf string, v application.Dashboard, c application.ConnectionView) {
	@Breadcrumbs("Source")
	@PageHeader(c.Name, c.Descriptor.Name())
	<nav class="wake-tabs" aria-label="Source views">
		for _,tab:=range []string{"status","reports","access"} {
			<a href={ templ.SafeURL(connectionURL(c.ID, tab)) } aria-current={ currentPage(activeView(ctx, "status") == tab) }>{ stringTitle(tab) }</a>
		}
	</nav>
	if activeView(ctx,"status")=="access" {
		@ConnectionAccess(csrf, c)
	} else if activeView(ctx,"status")=="reports" {
		@ConnectionReports(csrf, c)
	} else {
		<section class="wake-card" id="workflow-progress">
			<h2>Current source state</h2>
			if c.Descriptor.ID()=="" {
				<p class="wake-notice">This provider is unavailable in this build.</p>
			} else if !c.CanAcquire && !c.CanDiscover {
				<p>This source interprets supplied evidence and does not perform automatic acquisition.</p>
			} else if v.Account.Connection()==c.ID {
				<p>Authorized account: <strong>{ v.Account.Details().Name() }</strong></p>
			} else {
				<p>Account confirmation is required before ongoing synchronization.</p>
			}
			if v.Storage.Paused {
				<p class="wake-notice">Upstream work is paused. <a href="/connections/recovery">Review recovery steps</a>.</p>
			}
			if c.MissingAccess {
				<p class="wake-notice">Source access is incomplete. <a href={ templ.SafeURL(connectionURL(c.ID, "access")) }>Repair settings and credentials</a>.</p>
			}
			<dl>
				for _,w:=range sourceWork(v,c) {
					<dt>{ operationLabel(w.Operation) }</dt>
					<dd>
						@StateBadge(progressLabel(w.Progress))
						<span class="wake-help wake-cell-note">Next eligible: { known(w.Next) }</span>
						if w.Failure!="" {
							<p class="wake-error-text">{ w.Failure }</p>
						}
					</dd>
				}
			</dl>
			if connectionFailure(v,c) && !v.Storage.Paused {
				<form method="post" action={ templ.SafeURL("/connections/" + c.ID + "/retry") }><input type="hidden" name="csrf" value={ csrf }/><button class="btn" type="submit">Retry connection</button></form>
			}
			<a href={ templ.SafeURL(connectionURL(c.ID, "reports")) }>Inspect processing and recent reports</a>
		</section>
		if c.CanDiscover && v.Account.ID()=="" {
			<section class="wake-card">
				<h2>Choose your account</h2>@DiscoveredAccounts(c, v)
			</section>
		} else if c.CanDiscover {
			<details class="wake-card">
				<summary>Discovered account references</summary>@DiscoveredAccounts(c, v)
			</details>
		}
	}
}

templ DiscoveredAccounts(c application.ConnectionView, v application.Dashboard) {
	if len(c.Candidates)==0 {
		<p>Discovery has not returned any accounts yet.</p>
	} else {
		<section class="wake-table-scroll" aria-label="Discovered accounts">
			<table class="table">
				<caption>Discovered accounts</caption><thead><tr><th scope="col">Account</th><th scope="col">Name</th><th scope="col">Currency</th><th scope="col">Authority</th></tr></thead>
				<tbody>
					for _,candidate:=range c.Candidates {
						<tr>
							<td>{ candidate.Candidate.Reference().Value() }</td>
							<td>{ known(candidate.Candidate.Name()) }</td>
							<td>{ known(currencyText(candidate.Candidate.Currency())) }</td>
							<td>
								if v.Account.ID()=="" {
									<a href={ templ.SafeURL(confirmURL(c.ID, candidate)) }>Confirm account</a>
								} else if v.Account.Reference()==candidate.Candidate.Reference()&&v.Account.Connection()==c.ID {
									Activated
								} else {
									Candidate only
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</section>
	}
}

templ ProviderSettings(descriptor provider.Descriptor, settings provider.Settings, scope, owner string) {
	for _,field:=range descriptor.Fields() {
		if field.Kind()==provider.TextField {
			<p><label for={ providerFieldID(scope, owner, field) }>{ field.Label() }</label><input class="input" id={ providerFieldID(scope, owner, field) } name={ "setting." + field.Key() } value={ settingValue(settings, field.Key()) } required?={ field.Required() } maxlength="4096"/></p>
		}
	}
}

templ ConnectionAccess(csrf string, c application.ConnectionView) {
	<section class="wake-card wake-connection">
		<h2>{ c.Name }</h2>
		<details><summary>Source identity</summary><p>{ c.ID } · { c.Provider }</p></details>
		<p class="wake-help">Stored settings and credentials do not establish that the provider is reachable.</p>
		if c.MissingAccess {
			<p id={ "access-missing-" + c.ID } class="wake-notice">Access configuration is missing or incomplete. Review the source settings and required credentials.</p>
		}
		<form method="post" action={ templ.SafeURL("/connections/" + c.ID + "/settings") }>
			<input type="hidden" name="csrf" value={ csrf }/>
			<p><label for={ "name-" + c.ID }>Connection name</label><input class="input" id={ "name-" + c.ID } name="connection_name" value={ c.Name } maxlength="256" required/></p>
			@ProviderSettings(c.Descriptor, c.Settings, "update", c.ID)
			<button class="btn" type="submit">Save connection settings and retry</button>
		</form>
		for _,field:=range c.Descriptor.Fields() {
			if field.Kind()==provider.SecretField {
				<form method="post" action={ templ.SafeURL("/connections/" + c.ID + "/secrets") }>
					<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="secret_key" value={ field.Key() }/>
					<p><label for={ providerFieldID("update", c.ID, field) }>{ "Replacement "+field.Label() }</label><input class="input" id={ providerFieldID("update", c.ID, field) } name={ "secret." + field.Key() } type="password" autocomplete="new-password" required maxlength="4096"/></p>
					<button class="btn" type="submit">Replace credential and retry</button>
				</form>
			}
		}
	</section>
}

templ ConnectionSetup(csrf string, registrations []provider.Registration) {
	@Breadcrumbs("Add source")
	@PageHeader("Add source connection", "Configure a source before granting synchronization authority.")
	if len(registrations)==0 {
		<p>No source providers are available in this build.</p>
	}
	for _,registration:=range registrations {
		<section class="wake-card">
			<h2>{ registration.Descriptor().Name() }</h2>
			<form method="post" action="/connections">
				<input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="provider" value={ registration.Descriptor().ID() }/>
				<p><label for={ "connection-name-" + registration.Descriptor().ID() }>Connection name</label><input class="input" id={ "connection-name-" + registration.Descriptor().ID() } name="connection_name" required maxlength="256"/></p>
				@ProviderSettings(registration.Descriptor(), provider.Settings{}, "create", registration.Descriptor().ID())
				for _,field:=range registration.Descriptor().Fields() {
					if field.Kind()==provider.SecretField {
						<p><label for={ providerFieldID("create", registration.Descriptor().ID(), field) }>{ field.Label() }</label><input class="input" id={ providerFieldID("create", registration.Descriptor().ID(), field) } name={ "secret." + field.Key() } type="password" autocomplete="new-password" required?={ field.Required() } maxlength="4096"/></p>
					}
				}
				<button class="btn btn-primary" type="submit">Create connection</button>
			</form>
		</section>
	}
}

templ ReferenceSettings(csrf string, view application.Dashboard) {
	<section class="wake-card" id="reference-setting">
		<h2>Instrument reference access</h2>
		<p>OpenFIGI mapping works anonymously. An optional key increases the shared request allowance.</p>
		if view.ReferenceKey {
			<p>
				@StateBadge("Key stored")
			</p>
		} else {
			<p>Anonymous access</p>
		}
		if view.ReferenceFailure!="" {
			<p class="wake-notice">{ view.ReferenceFailure }</p>
		}
		<form method="post" action="/reference/key"><input type="hidden" name="csrf" value={ csrf }/><p><label for="openfigi-key">OpenFIGI key (leave empty to select anonymous access)</label><input class="input" id="openfigi-key" name="key" type="password" autocomplete="new-password" maxlength="4096"/></p><button class="btn" type="submit">Save reference setting and retry</button></form>
	</section>
}

templ RecoveryPage(csrf string, view application.Dashboard) {
	@PageHeader("Review recovered access", "Retained financial history stays inspectable while upstream work is paused.")
	@ConnectionsNavigation("recovery")
	if !view.Storage.Paused {
		<section class="wake-card"><h2>Access review complete</h2><p>Upstream work is not paused for storage recovery.</p><a href="/connections">Inspect connections</a></section>
	} else {
		<section class="wake-card wake-priority" id="storage-recovery-title">
			<h2>1. Restore source access</h2>
			if view.Storage.WarehouseReset {
				<p id="warehouse-reset-notice">Financial history was reset. Settings and credentials were retained; account discovery and confirmation are required again after resume.</p>
			}
			for _,c:=range view.Connections {
				<p><strong>{ c.Name }</strong> · Settings: { readiness(c.SettingsStored) } · Token: { readiness(c.CredentialStored) }</p>
			}
		</section>
		for _,c:=range view.Connections {
			if c.MissingAccess {
				@ConnectionAccess(csrf, c)
			}
		}
		<section class="wake-card">
			<h2>2. Review reference access</h2>
			if view.Storage.ReferenceReview {
				<p id="reference-review-required">Save the OpenFIGI setting, including an explicit anonymous selection if appropriate.</p>
			} else {
				<p>Reference access has been reviewed.</p>
			}
		</section>
		if view.Storage.ReferenceReview {
			@ReferenceSettings(csrf, view)
		}
		<section class="wake-card">
			<h2>3. Resume upstream work</h2>
			<p>Resume grants permission to contact configured sources. It does not confirm a newly discovered account.</p>
			if !recoveryReady(view) {
				<p class="wake-notice">Complete the source and reference steps above before resuming.</p>
			}
			<form method="post" action="/recovery/resume"><input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="revision" value={ strconv.FormatInt(view.Storage.Revision, 10) }/><button class="btn btn-primary" type="submit" disabled?={ !recoveryReady(view) }>Resume upstream work</button></form>
		</section>
	}
	<a href="/system/maintenance">Inspect rebuild history and maintenance</a>
}

templ ConnectionReports(csrf string, c application.ConnectionView) {
	<section class="wake-card">
		<h2>Recent reports</h2>
		<p class="wake-help">Up to 10 recent acquisitions. Requested and returned bounds have distinct meanings; neither proves complete history.</p>
		if len(c.Processing)==0 {
			<p>No acquired financial reports yet.</p>
		}
		for _,p:=range c.Processing {
			<article class="wake-report-row">
				<div class="wake-card-heading">
					<h3><a href={ templ.SafeURL(navURL(ctx, "/evidence/"+p.Artifact)) }>Source report</a></h3>
					if c.Descriptor.ID()=="" {
						<p>Provider unavailable. Evidence is retained.</p>
					} else if !c.CanNormalize {
						<p>Evidence retained. This source does not provide normalization.</p>
					} else if p.Complete {
						@StateBadge("Processing complete")
					} else {
						@StateBadge("Processing pending")
					}
				</div>
				<dl><dt>Requested</dt><dd>{ known(p.RequestedFrom) } to { known(p.RequestedTo) }</dd><dt>Returned</dt><dd>{ known(p.ReportedFrom) } to { known(p.ReportedTo) }</dd><dt>Processed claims</dt><dd>{ strconv.FormatInt(p.TradeClaims,10) } trades · { strconv.FormatInt(p.LifecycleClaims,10) } option outcomes · { strconv.FormatInt(p.ConversionClaims,10) } conversions</dd></dl>
				if p.NeedsReview>0 {
					<p>{ strconv.FormatInt(p.NeedsReview,10) } source claims need identity review. <a href={ templ.SafeURL(navURL(ctx, "/evidence/"+p.Artifact)) }>Inspect report observations</a>.</p>
				}
				if c.CanNormalize && p.Failure!="" {
					<p class="wake-notice">{ p.Failure }</p>
					<form method="post" action={ templ.SafeURL("/processing/" + p.Artifact + "/retry") }><input type="hidden" name="csrf" value={ csrf }/><button class="btn" type="submit">Retry processing report</button></form>
				}
				<details><summary>Report identity and excluded rows</summary><p>{ p.Artifact } · { strconv.FormatInt(p.ExcludedRows,10) } excluded rows</p></details>
				if c.CanNormalize && p.Failure=="" {
					<details><summary>Processing actions</summary><form method="post" action={ templ.SafeURL("/processing/" + p.Artifact + "/retry") }><input type="hidden" name="csrf" value={ csrf }/><button class="btn" type="submit">Retry processing report</button></form></details>
				}
			</article>
		}
	</section>
}

templ MaintenancePage(csrf string, view application.Dashboard) {
	@PageHeader("Maintenance", "Rebuild derived views from retained evidence and decisions.")
	@SystemNavigation("maintenance")
	<section class="wake-card" id="maintenance"><h2>Rebuild accepted views</h2><p>Original evidence and retained decisions stay intact. Rebuild resumes from committed progress after restart.</p><form method="post" action="/recovery/rebuild"><input type="hidden" name="csrf" value={ csrf }/><input type="hidden" name="submission" value={ rand.Text() }/><button class="btn" type="submit">Rebuild accepted views</button></form></section>
	<section class="wake-card" id="workflow-progress">
		<h2>Recovery history</h2>
		if len(view.Recovery)==0 {
			<p>No rebuilds recorded.</p>
		}
		for index,j:=range view.Recovery {
			<article class="wake-report-row">
				<h3>
					Rebuild
					@StateBadge(j.Status)
				</h3>
				<p>{ strconv.FormatInt(j.Completed,10) } / { strconv.FormatInt(j.Total,10) } entities</p>
				<p class="wake-help">Started { j.Created }</p>
				if j.Failure!="" {
					<p class="wake-notice">{ j.Failure }</p>
				}
				if index==0 && j.Status=="failed" {
					<form method="post" action={ templ.SafeURL("/recovery/" + j.ID + "/retry") }><input type="hidden" name="csrf" value={ csrf }/><button class="btn" type="submit">Retry rebuild</button></form>
				}
				<details><summary>Rebuild identity</summary><p>{ j.ID }</p></details>
			</article>
		}
	</section>
}

templ ActivityPage(view application.Dashboard) {
	@PageHeader("Activity", "Inspect financial history and resolve questions from retained evidence.")
	@ActivityNavigation(activeView(ctx, "all"))
	if view.Account.ID()=="" {
		<section class="wake-card"><h2>Confirm an account to begin</h2><a class="btn btn-primary" href="/connections">Review source setup</a></section>
	}
	if activeView(ctx,"all")=="review" {
		@ReviewQueue(view)
	} else if activeView(ctx,"all")=="instruments" {
		@InstrumentsView(view)
	} else {
		@ActivityRows(view)
	}
}

templ ReviewQueue(view application.Dashboard) {
	<section class="wake-card">
		<h2>Needs review</h2>
		<p class="wake-help">Activity disagreements and ambiguous or conflicting instrument identity. Source failures and ordinary reference gaps remain separate.</p>
		if len(reviews(view))==0 {
			<p>No activity or identity conflicts are awaiting review.</p>
		} else {
			<ul class="wake-task-list">
				for _,r:=range reviews(view) {
					<li><div><span class="wake-help">{ r.Kind }</span><h3><a href={ templ.SafeURL(navURL(ctx, r.Href)) }>{ r.Label }</a></h3><p>{ r.Reason }</p></div><a class="btn" href={ templ.SafeURL(navURL(ctx, r.Href)) }>Review</a></li>
				}
			</ul>
		}
	</section>
}

templ ActivityRows(view application.Dashboard) {
	<section class="wake-card" id="activity-rows">
		<div class="wake-card-heading"><div><h2>Financial activity</h2><p>{ known(view.Account.Details().Name()) }</p></div><span class="wake-help" role="status">{ resultCount(len(filteredActivity(ctx,view)),len(activityItems(view))) }</span></div>
		@ListFilters(false)
		<section class="wake-grid" id="activity-grid" data-grid="activity" aria-label="Financial activity">
			<section class="wake-table-scroll" aria-label="Financial activity table">
				<table class="table">
					<caption>Recorded financial activity</caption><thead><tr><th scope="col" data-field="label">Activity</th><th scope="col" data-field="date">Date</th><th scope="col" data-field="quantity" data-sort="decimal">Quantity / currency roles</th><th scope="col" data-field="price" data-sort="decimal">Price / rate</th><th scope="col" data-field="state">Activity state</th><th scope="col" data-field="reference">Reference identity</th></tr></thead>
					<tbody>
						for _,r:=range filteredActivity(ctx,view) {
							<tr id={ "activity-" + r.ID }>
								<td><a href={ templ.SafeURL(navURL(ctx, r.Href)) } data-record={ r.ID }>{ r.Label }</a><span class="wake-help wake-cell-note">{ stringTitle(r.Kind) }</span></td>
								<td>{ r.Date }</td>
								<td data-sort-value={ r.Quantity }>{ r.Quantity }</td>
								<td data-sort-value={ r.Price + " " + r.Basis }>{ r.Price }<span class="wake-help wake-cell-note">{ r.Basis }</span></td>
								<td>
									@ActivityBadge(r.FinancialState)
								</td>
								<td>
									if r.InstrumentID!="" {
										<a href={ templ.SafeURL(navURL(ctx, "/instruments/"+r.InstrumentID)) }>{ r.Reference }</a>
									} else {
										Not applicable
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</section>
		</section>
		if len(filteredActivity(ctx,view))==0 {
			<p>No activity matches these filters.</p>
		}
	</section>
}

templ InstrumentsView(view application.Dashboard) {
	<section class="wake-card">
		<div class="wake-card-heading"><h2>Instruments</h2><span class="wake-help" role="status">{ resultCount(len(filteredInstruments(ctx,view)),len(view.Instruments)) }</span></div>
		@ListFilters(true)
		<section class="wake-grid" id="instruments-grid" data-grid="instruments" aria-label="Instruments">
			<section class="wake-table-scroll" aria-label="Instrument table">
				<table class="table">
					<caption>Financial instruments</caption><thead><tr><th scope="col" data-field="name">Instrument</th><th scope="col" data-field="kind">Kind</th><th scope="col" data-field="ticker">Reported symbol</th><th scope="col" data-field="state">Reference identity</th></tr></thead>
					<tbody>
						for _,i:=range filteredInstruments(ctx,view) {
							<tr id={ "instrument-" + i.ID() }>
								<td><a href={ templ.SafeURL(navURL(ctx, "/instruments/"+i.ID())) } data-record={ i.ID() }>{ known(i.Name()) }</a></td>
								<td>{ i.Kind() }</td>
								<td>{ known(i.Ticker()) }</td>
								<td>
									@InstrumentBadge(i)
								</td>
							</tr>
						}
					</tbody>
				</table>
			</section>
		</section>
		if len(filteredInstruments(ctx,view))==0 {
			<p>No instruments match these filters.</p>
		}
	</section>
}

templ ListFilters(instruments bool) {
	<form class="wake-filters" method="get" action="/activity" hx-get="/activity" hx-target="#workspace-content" hx-select="#workspace-content" hx-swap="morph:outerHTML" hx-trigger="submit, change" data-list-filters>
		if instruments {
			<input type="hidden" name="view" value="instruments"/>
		}
		<input type="hidden" name="sort" value={ page(ctx).Query.Get("sort") }/>
		<input type="hidden" name="dir" value={ page(ctx).Query.Get("dir") }/>
		<p><label for="activity-search">Search</label><input class="input" id="activity-search" name="q" type="search" value={ page(ctx).Query.Get("q") } placeholder="Instrument, date or value"/></p>
		<p>
			<label for="activity-kind">Kind</label>
			<select class="select" id="activity-kind" name="kind">
				<option value="">All kinds</option>
				if instruments {
					for _,v:=range []string{"equity","fund","option","debt"} {
						<option value={ v } selected?={ page(ctx).Query.Get("kind")==v }>{ stringTitle(v) }</option>
					}
				} else {
					for _,v:=range []string{"trade","option outcome","conversion"} {
						<option value={ v } selected?={ page(ctx).Query.Get("kind")==v }>{ stringTitle(v) }</option>
					}
				}
			</select>
		</p>
		<p>
			<label for="activity-state">State</label>
			<select class="select" id="activity-state" name="state">
				<option value="">All states</option>
				if instruments {
					for _,v:=range []string{"resolved","review","gaps"} {
						<option value={ v } selected?={ page(ctx).Query.Get("state")==v }>{ stringTitle(v) }</option>
					}
				} else {
					for _,v:=range []string{"accepted","review","cancelled","superseded"} {
						<option value={ v } selected?={ page(ctx).Query.Get("state")==v }>{ stringTitle(v) }</option>
					}
				}
			</select>
		</p>
		<button class="btn" type="submit">Apply filters</button><a href={ templ.SafeURL(resetListURL(instruments)) }>Reset filters</a>
	</form>
}

templ ReferencePage(csrf string, view application.Dashboard) {
	@PageHeader("Instrument reference", "OpenFIGI access is separate from your financial source.")
	@ConnectionsNavigation("reference")
	@ReferenceSettings(csrf, view)
}

templ SystemNavigation(view string) {
	<nav class="wake-tabs" aria-label="System views"><a href="/status" aria-current={ currentPage(view == "status") }>Status</a><a href="/configuration" aria-current={ currentPage(view == "configuration") }>Configuration</a><a href="/system/maintenance" aria-current={ currentPage(view == "maintenance") }>Maintenance</a></nav>
}
