package admin

templ Shell(title string, csrf string, content templ.Component) {
	@SectionShell(title, csrf, title, content)
}

templ SectionShell(title string, csrf string, section string, content templ.Component) {
	{{ contextual := section == "Activity" || section == "Reports" }}
	{{ section = workspaceSection(ctx, section) }}
	if page(ctx).Fragment {
		@WorkspaceContent(csrf, content)
	} else {
		<!DOCTYPE html>
		<html lang="en" data-theme="wake-light" data-palette="steel" data-typography="default">
			<head>
				<meta charset="utf-8"/>
				<meta name="viewport" content="width=device-width, initial-scale=1"/>
				<meta name="wake-csrf-token" content={ csrf }/>
				<title>{ title } · Wake</title>
				<meta name="htmx-config" content={ `{"allowEval":false,"allowScriptTags":false,"selfRequestsOnly":true,"historyCacheSize":0,"timeout":8000}` }/>
				<meta name="theme-color" content="#293039"/>
				<script src="/assets/theme.js"></script>
				<link rel="icon" href="/assets/brand/favicon.ico" sizes="16x16 32x32 48x48"/>
				<link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml" sizes="any"/>
				<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png" sizes="180x180"/>
				<link rel="stylesheet" href="/assets/vendor/daisyui-5.7.50/daisyui.css"/>
				<link rel="stylesheet" href="/assets/vendor/tabulator-6.7.1/tabulator.min.css"/>
				<link rel="stylesheet" href="/assets/app.css"/>
				<script defer src="/assets/vendor/htmx-2.0.11/htmx.min.js"></script>
				<script defer src="/assets/vendor/htmx-sse-2.2.4/sse.min.js"></script>
				<script defer src="/assets/vendor/tabulator-6.7.1/tabulator.min.js"></script>
				<script defer src="/assets/app.js"></script>
			</head>
			<body data-signed-in?={ csrf != "" } data-contextual-workspace?={ contextual } data-live-state="connected" hx-ext="sse" { streamAttributes(csrf)... } hx-history="false">
				<a class="wake-skip" href="#main-content">Skip to content</a>
				<div class="wake-app">
					<header class="wake-masthead" data-navigation>
						<div class="wake-brand-row">
							<a class="wake-brand" href="/">
								<img src="/assets/brand/wake-logo-reversed.svg" width="143" height="45" alt="Wake"/>
							</a>
							if csrf!="" {
								<button class="btn btn-sm wake-menu-toggle" type="button" aria-expanded="true" aria-controls="main-navigation" hidden>Menu</button>
							}
						</div>
						if csrf!="" {
							<nav aria-label="Main navigation" class="wake-nav" id="main-navigation">
								<ul aria-label="Financial records">
									<li>
										@NavigationLink("Overview", "/", "overview", section == "Overview")
									</li>
									<li>@NavigationLink("Reports", "/reports", "reports", section == "Reports")</li>
									<li>
										@NavigationLink("Activity", "/activity", "trades", section == "Activity")
									</li>
									<li>
										@NavigationLink("Instruments", "/instruments", "instruments", section == "Instruments")
									</li>
									<li>
										@NavigationLink("Positions", "/positions", "positions", section == "Positions")
									</li>
									<li>
										@NavigationLink("Needs review", "/review", "review", section == "Needs review")
									</li>
								</ul>
								<ul aria-label="Administration">
									<li>
										@NavigationLink("Connections", "/connections", "connections", section == "Connections")
									</li>
									<li>
										@NavigationLink("System", "/system", "configuration", section == "System" || section == "Daemon status" || section == "Configuration")
									</li>
								</ul>
							</nav>
							<div class="wake-session">
								<div class="wake-contact">
									<span class="wake-contact-indicator" aria-hidden="true"></span>
									<details class="wake-contact-details">
										<summary class="wake-contact-trigger"><span id="daemon-contact" role="status" aria-live="polite">Daemon connected</span></summary>
										<p class="wake-contact-panel">This browser can reach Wake while connected. Check Overview for the last report from each source.</p>
									</details>
								</div>
								<form method="post" action="/logout" hx-boost="false">
									<input type="hidden" name="csrf" value={ csrf }/>
									<button class="btn wake-sign-out" data-submit-label="Signing out…" type="submit">Sign out</button>
								</form>
							</div>
						}
					</header>
					<div class="wake-workspace">
						<main class="wake-main" id="main-content" tabindex="-1">
							@WorkspaceContent(csrf, content)
						</main>
					</div>
				</div>
			</body>
		</html>
	}
}

templ WorkspaceContent(csrf string, content templ.Component) {
	<div id="workspace-content" { workspaceAttributes(ctx,csrf)... }>
		@content
	</div>
}
