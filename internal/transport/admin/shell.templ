package admin

templ Shell(title string, csrf string, content templ.Component) {
	@SectionShell(title, csrf, title, content)
}

templ SectionShell(title string, csrf string, section string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" data-theme="wake-light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="wake-csrf-token" content={ csrf }/>
			<title>{ title } · Wake</title>
			<meta name="theme-color" content="#b0b6bc"/>
			<script src="/assets/theme.js"></script>
			<link rel="icon" href="/assets/brand/favicon.ico" sizes="16x16 32x32 48x48"/>
			<link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml" sizes="any"/>
			<link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png" sizes="180x180"/>
			<link rel="stylesheet" href="/assets/vendor/daisyui-5.5.14/daisyui.css"/>
			<link rel="stylesheet" href="/assets/app.css"/>
			<script defer src="/assets/app.js"></script>
		</head>
		<body data-live-state="connected">
			<a class="wake-skip" href="#main-content">Skip to content</a>
			<div class="wake-app">
				<aside class="wake-sidebar" data-navigation>
					<div class="wake-brand-row">
						<a class="wake-brand" href="/">
							<img class="wake-logo-light" src="/assets/brand/wake-logo.svg" width="143" height="45" alt="Wake"/>
							<img class="wake-logo-dark" src="/assets/brand/wake-logo-reversed.svg" width="143" height="45" alt="Wake"/>
							<span>Financial evidence</span>
						</a>
						if csrf!="" {
							<button class="btn btn-sm wake-menu-toggle" type="button" aria-expanded="true" aria-controls="main-navigation" hidden>Menu</button>
						}
					</div>
					if csrf!="" {
						<nav aria-label="Main navigation" class="wake-nav" id="main-navigation">
							<ul class="menu">
								<li class="menu-title">Workspace</li>
								<li>
									@SidebarLink("Overview", "/", "overview", section == "Overview")
								</li>
								<li>
									@SidebarLink("Daemon status", "/status", "overview", section == "Daemon status")
								</li>
								<li class="menu-title">Settings</li>
								<li>
									@SidebarLink("Configuration", "/configuration", "configuration", section == "Configuration")
								</li>
							</ul>
						</nav>
					}
				</aside>
				<div class="wake-workspace">
					<header
						class="wake-toolbar"
					>
						if csrf!="" {
							<div class="wake-contact">
								<span class="wake-contact-indicator" aria-hidden="true"></span>
								<div class="wake-contact-details">
									<button class="wake-contact-trigger" type="button" aria-describedby="status-contact-detail"><span id="daemon-contact" role="status" aria-live="polite">Daemon connected</span></button>
									<span id="status-contact-detail" class="wake-contact-tooltip" role="tooltip">Administrative shell is available. Reload to check current status.</span>
								</div>
							</div>
						}
						<div class="wake-toolbar-preferences">
							@ThemeControl()
						</div>
					</header>
					<main class="wake-main" id="main-content" tabindex="-1">
						@content
					</main>
				</div>
			</div>
		</body>
	</html>
}
