package admin

import "go.trippwill.dev/wake/internal/config"

templ Login(message string, view BrowserAccessView) {
	@Shell("Sign in", "", LoginBody(message, view))
}

templ LoginBody(message string, view BrowserAccessView) {
	<div class="wake-login wake-stack">
		<h1>Sign in to Wake</h1>
		if message != "" {
			<div class="wake-notice wake-error" role="alert">{ message }</div>
		}
		if view.Password {
			<form method="post" action="/login" class="wake-stack">
				<label class="wake-field" for="password">Password<input class="input" id="password" name="password" type="password" autocomplete="current-password" required/></label>
				<button class="btn btn-primary" type="submit">Sign in</button>
			</form>
		}
		if view.CanAssert {
			<form method="post" action="/passkeys/begin" class="wake-stack" data-passkey-login hx-boost="false">
				<button class={ "btn", templ.KV("btn-primary", !view.Password) } id="passkey-login" type="submit" hidden>Sign in with a passkey</button>
				<div class="wake-passkey-status" role="status" data-passkey-status></div>
				@PasskeyBrowserHelp()
			</form>
		} else if len(view.Passkeys) != 0 {
			@PasskeyOriginHelp(view.Eligible)
		}
		<details>
			if len(view.Passkeys) != 0 {
				<summary>Lost access?</summary>
			} else {
				<summary>Forgot your password?</summary>
			}
			<p class="wake-help">Run <code>wake access set password</code> on the Wake host, then sign in with your new password.</p>
		</details>
	</div>
}

templ PasswordRequired() {
	@Shell("Set a password", "", PasswordRequiredBody())
}

templ PasswordRequiredBody() {
	<div class="wake-login wake-stack">
		<h1>Set your Wake password</h1>
		<p>On the Wake host, run:</p>
		<pre><code>wake access set password</code></pre>
		<p>Enter and confirm your password in the terminal, then <a href="/login">sign in</a>.</p>
	</div>
}

templ ChangePassword(csrf, message string) {
	@SectionShell("Change password", csrf, "System", ChangePasswordBody(csrf, message))
}

templ ChangePasswordBody(csrf, message string) {
	@PageHeader("Change password", "Changing your password signs out your other browser sessions.")
	<section class="wake-card wake-stack">
		if message != "" {
			<div class="wake-notice wake-error" role="alert">{ message }</div>
		}
		<form method="post" action={ passwordPath } class="wake-stack">
			<input type="hidden" name="csrf" value={ csrf }/>
			<label class="wake-field" for="current">Current password<input class="input" id="current" name="current" type="password" autocomplete="current-password" required/></label>
			@NewPasswordFields()
			<div class="wake-actions">
				<button class="btn btn-primary" type="submit">Change password</button>
				<a href="/system/settings">Cancel</a>
			</div>
		</form>
	</section>
}

templ NewPasswordFields() {
	<label class="wake-field" for="password">New password<input class="input" id="password" name="password" type="password" autocomplete="new-password" aria-describedby="password-help" required/></label>
	<p class="wake-help" id="password-help">Use at least 12 bytes.</p>
	<label class="wake-field" for="confirm">Confirm new password<input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" required/></label>
}

templ Overview(csrf, path string, status Status, cfg config.Config) {
	@SectionShell(pageTitle(path), csrf, "System", OverviewBody(path, status, cfg))
}

templ Settings(csrf string, view BrowserAccessView) {
	@SectionShell("Settings", csrf, "System", SettingsBody(csrf, view))
}

templ SettingsBody(csrf string, view BrowserAccessView) {
	@PageHeader("Settings", "Manage this browser’s appearance and how you sign in to Wake.")
	@SystemNavigation("settings")
	<section class="wake-card wake-appearance">
		<h2>Appearance</h2>
		<p class="wake-help">System follows your device’s appearance.</p>
		@ThemeControl()
	</section>
	@BrowserAccess(csrf, view)
}

templ OverviewBody(path string, status Status, cfg config.Config) {
	@PageHeader(pageTitle(path), "Installation health, effective configuration and maintenance.")
	@SystemNavigation(systemView(path))
	if path=="/system/configuration" {
		<section class="wake-card">
			<h2>Effective storage and runtime configuration</h2>
			<dl>
				<dt>Configuration file</dt>
				<dd>
					if cfg.Paths.ConfigFile != "" {
						{ cfg.Paths.ConfigFile }
					} else {
						None · No TOML file loaded at startup.
					}
				</dd>
				<dt>Financial database</dt>
				<dd>{ cfg.Storage.WarehousePath }</dd>
				<dt>Connections database</dt>
				<dd>{ cfg.Storage.ConnectionsPath }</dd>
				<dt>Runtime directory</dt>
				<dd>{ cfg.Paths.RuntimeDir }</dd>
				<dt>Admin authentication</dt>
				<dd><a href="/system/settings">Manage browser access</a></dd>
				<dt>Admin listener</dt>
				<dd>{ cfg.Admin.Address() }</dd>
				<dt>Browser URL</dt>
				<dd>{ cfg.Admin.Origin() }</dd>
				<dt>Financial API listener</dt>
				<dd>{ cfg.API.Address() }</dd>
				<dt>Currency list refresh</dt>
				<dd>
					if cfg.Admin.CurrencyRefresh {
						Enabled
					} else {
						Disabled
					}
				</dd>
			</dl>
			<a href="/connections">Manage source and reference access</a>
		</section>
	} else {
		<section class="wake-card">
			<h2>Daemon status</h2>
			<p role="status">Daemon running</p>
			<dl>
				<dt>Started (UTC)</dt>
				<dd>{ known(status.StartedAt) }</dd>
				<dt>Credential protection</dt>
				<dd>
					if status.CredentialProtection {
						Enabled
					} else {
						Unavailable. { status.CredentialIssue }
					}
				</dd>
				<dt>Financial database size</dt>
				<dd>{ warehouseSizeText(status.WarehouseBytes) }</dd>
			</dl>
			<p class="wake-help">Financial database, including retained reports. Excludes encrypted access storage and temporary journals.</p>
			<p class="wake-help">Daemon contact confirms reachability. Acquisition, processing and financial uncertainty are shown in their own workspaces.</p>
		</section>
	}
}

templ ErrorPage(title, message string) {
	@PageHeader(title, message)
	<section class="wake-card"><h2>Choose a next step</h2><p>Return to your workspace or inspect daemon status before retrying.</p><div class="wake-actions"><a href={ templ.SafeURL(returnURL(ctx)) } data-return>Return to previous work</a><a href="/system">Inspect daemon status</a></div></section>
}
