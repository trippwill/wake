package admin

import "go.trippwill.dev/wake/internal/config"

templ Login(message string) {
	@Shell("Sign in", "", LoginBody(message))
}

templ LoginBody(message string) {
	<div class="wake-login wake-stack">
		<h1>Sign in to Wake</h1>
		<p>Enter the operator unlock created by wake setup.</p>
		if message != "" {
			<div class="alert alert-error" role="alert">{ message }</div>
		}
		<form method="post" action="/login" class="wake-stack">
			<label class="wake-field" for="unlock">Operator unlock<input class="input" id="unlock" name="unlock" type="password" autocomplete="current-password" required/></label>
			<button class="btn btn-primary" type="submit">Sign in</button>
		</form>
	</div>
}

templ Overview(csrf, path string, status Status, cfg config.Config) {
	@Shell(pageTitle(path), csrf, OverviewBody(path, status, cfg))
}

templ OverviewBody(path string, status Status, cfg config.Config) {
	<div class="wake-stack">
		<h1>{ pageTitle(path) }</h1>
		if path == "/configuration" {
			<dl><dt>Data directory</dt><dd>{ cfg.Paths.DataDir }</dd><dt>Runtime directory</dt><dd>{ cfg.Paths.RuntimeDir }</dd><dt>Admin authentication</dt><dd>{ cfg.Admin.AuthMode }</dd></dl>
			<p>No acquisition providers are installed.</p>
		} else {
			<p role="status">Daemon running</p>
			<dl>
				<dt>Started (UTC)</dt>
				<dd>{ status.StartedAt }</dd>
				<dt>Credential protection</dt>
				<dd>
					if status.CredentialProtection {
						<span>Enabled</span>
					} else {
						<span>Unavailable · Run wake setup to provision a master key.</span>
					}
				</dd>
			</dl>
			<p>Financial synchronization, imports and financial queries are unavailable in this foundation build.</p>
		}
	</div>
}
